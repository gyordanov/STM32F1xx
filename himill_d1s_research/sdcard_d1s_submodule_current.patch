+#if D1S_SD_READ_VERIFY
+static char d1s_hex_digit (uint8_t value)
+{
+    value &= 0x0F;
+    return value < 10 ? '0' + value : 'A' + value - 10;
+}
+
+static char d1s_printable (uint8_t value)
+{
+    return value >= ' ' && value <= '~' ? (char)value : '.';
+}
+
+static void d1s_sddbg_verify_dump (const char *tag, const uint8_t *data, uint8_t len)
+{
+    char buf[128];
+    char *const end = buf + sizeof(buf) - 3; // reserve room for ']' + EOL + NUL
+    char *out = buf;
+    int n = snprintf(buf, sizeof(buf) - 3, "[MSG:SDDBG %s hex=", tag);
+
+    if(n < 0)
+        n = 0;
+    else if(n > (int)(sizeof(buf) - 4))
+        n = (int)(sizeof(buf) - 4); // snprintf reports the untruncated length
+
+    out += n;
+
+    for(uint8_t i = 0; i < len && end - out >= 2; i++) {
+        *out++ = d1s_hex_digit(data[i] >> 4);
+        *out++ = d1s_hex_digit(data[i]);
+    }
+
+    if(end - out >= 5) {
+        memcpy(out, " asc=", 5);
+        out += 5;
+        for(uint8_t i = 0; i < len && out < end; i++)
+            *out++ = d1s_printable(data[i]);
+    }
+
+    *out++ = ']';
+    *out++ = ASCII_LF;
+    *out = '\0';
+    hal.stream.write(buf);
+}
