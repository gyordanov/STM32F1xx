+static uint_fast8_t d1s_sddbg_line_len = 0;
+static line_number_t d1s_sddbg_line_number = 1;
+static bool d1s_sddbg_line_overflow = false;
+
+static void d1s_sddbg_reset (line_number_t line_number)
+{
+    d1s_sddbg_line_len = 0;
+    d1s_sddbg_line[0] = '\0';
+    d1s_sddbg_line_number = line_number;
+    d1s_sddbg_line_overflow = false;
+}
+
+static void d1s_sddbg_capture (int32_t c)
+{
+    if(c == ASCII_CR || c == ASCII_LF)
+        return;
+
+    if(d1s_sddbg_line_len < D1S_SDDBG_LINE_LEN) {
+        char ch = c >= ' ' && c <= '~' ? (char)c : '?';
+
+        if(ch == '[' || ch == ']' || ch == '|')
+            ch = '?';
+
+        d1s_sddbg_line[d1s_sddbg_line_len++] = ch;
+        d1s_sddbg_line[d1s_sddbg_line_len] = '\0';
+    } else
+        d1s_sddbg_line_overflow = true;
+}
+
+static void d1s_sddbg_report (void)
+{
+    char buf[140];
+
+    snprintf(buf, sizeof(buf), "[MSG:SDDBG line=" UINT32FMT " pos=" UINT32FMT " text=%s%s]" ASCII_EOL,
+             d1s_sddbg_line_number, (uint32_t)file.pos, d1s_sddbg_line, d1s_sddbg_line_overflow ? "+" : "");
+    hal.stream.write(buf);
+}
+
+static void d1s_sddbg_msg (const char *tag)
+{
+    hal.stream.write("[MSG:SDDBG ");
+    hal.stream.write(tag);
+    hal.stream.write("]" ASCII_EOL);
+}
+#else
+#define d1s_sddbg_reset(line_number)
+#define d1s_sddbg_capture(c)
+#define d1s_sddbg_report()
+#define d1s_sddbg_msg(tag)
