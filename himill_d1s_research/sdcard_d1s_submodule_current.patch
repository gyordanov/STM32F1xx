+    diskio_d1s_verify_stats(&mismatches, &recovered, &failed, &last_sector, &last_attempt);
+    diskio_d1s_verify_detail(&last_offset, &last_first, &last_second);
+    snprintf(buf, sizeof(buf), "[MSG:SDDBG VERIFY %s mismatch=" UINT32FMT " recovered=" UINT32FMT " failed=" UINT32FMT " last=" UINT32FMT " attempt=%u off=%u a=%02X b=%02X]" ASCII_EOL,
+             reason, mismatches, recovered, failed, last_sector, (unsigned int)last_attempt,
+             (unsigned int)last_offset, (unsigned int)last_first, (unsigned int)last_second);
+    hal.stream.write(buf);
+
+    ctx_len = diskio_d1s_verify_context(&ctx_offset, first, second, sizeof(first));
+    if(ctx_len) {
+        snprintf(buf, sizeof(buf), "[MSG:SDDBG DIFF sector=" UINT32FMT " ctx_off=%u len=%u]" ASCII_EOL,
+                 last_sector, (unsigned int)ctx_offset, (unsigned int)ctx_len);
+        hal.stream.write(buf);
+        d1s_sddbg_verify_dump("READ1", first, ctx_len);
+        d1s_sddbg_verify_dump("READ2", second, ctx_len);
+    }
+
+    d1s_sddbg_verify_active = false;
+}
