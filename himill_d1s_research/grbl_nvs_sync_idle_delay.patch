+static uint32_t nvs_sync_not_before = 0;
+
+static void nvs_sync_delay_from_stream (void)
+{
+    if(hal.get_elapsed_ticks)
+        nvs_sync_not_before = hal.get_elapsed_ticks() + NVS_SYNC_IDLE_DELAY_MS;
+}
+
+static bool nvs_sync_delay_elapsed (void)
+{
+    return !hal.get_elapsed_ticks || (int32_t)(hal.get_elapsed_ticks() - nvs_sync_not_before) >= 0;
+}
