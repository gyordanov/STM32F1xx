--- a/protocol.c
+++ b/protocol.c
@@ -38,6 +38,10 @@
 #define RT_QUEUE_SIZE 16 // must be a power of 2
 #endif
 
+#ifndef NVS_SYNC_IDLE_DELAY_MS
+#define NVS_SYNC_IDLE_DELAY_MS 0
+#endif
+
 // Define line flags. Includes comment type tracking and line overflow detection.
 typedef union {
     uint8_t value;
@@ -56,6 +60,21 @@ static char line[LINE_BUFFER_SIZE]; // Line to be executed. Zero-terminated.
