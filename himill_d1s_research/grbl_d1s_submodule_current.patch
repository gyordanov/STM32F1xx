--- a/gcode.c
+++ b/gcode.c
@@ -314,6 +314,102 @@ inline static float gc_get_block_offset (parser_block_t *gc_block, uint_fast8_t
     return gc_block->modal.g5x_offset.data.coord.values[idx] + gc_state.g92_offset.coord.values[idx] + gc_state.modal.tool_length_offset[idx];
 }
 
+#ifdef ROTATION_ENABLE
+
+inline static bool gc_xy_rotation_active (coord_system_data_t *offset)
+{
+    return offset->rotation != 0.0f;
+}
+
+inline static plane_t gc_xy_rotation_plane (void)
+{
+    return (plane_t){ .axis_0 = X_AXIS, .axis_1 = Y_AXIS, .axis_linear = Z_AXIS };
+}
+
+static void gc_machine_to_work (coord_data_t *target, coord_system_data_t *offset)
+{
+    uint_fast8_t idx = N_AXIS;
+
+    do {
+        idx--;
+        target->values[idx] -= offset->coord.values[idx] + gc_state.g92_offset.coord.values[idx] + gc_state.modal.tool_length_offset[idx];
+    } while(idx);
+
+    if(gc_xy_rotation_active(offset))
+        rotate(target, gc_xy_rotation_plane(), -offset->rotation);
+}
+
+static void gc_work_to_machine (coord_data_t *target, coord_system_data_t *offset)
+{
+    uint_fast8_t idx = N_AXIS;
+
+    if(gc_xy_rotation_active(offset))
+        rotate(target, gc_xy_rotation_plane(), offset->rotation);
+
+    do {
+        idx--;
+        target->values[idx] += offset->coord.values[idx] + gc_state.g92_offset.coord.values[idx] + gc_state.modal.tool_length_offset[idx];
+    } while(idx);
+}
+
+static void gc_current_work_position (coord_data_t *target, coord_system_data_t *offset)
+{
+    memcpy(target, gc_state.position, sizeof(coord_data_t));
+    gc_machine_to_work(target, offset);
+}
+
+static void gc_solve_wcs_origin_from_work (coord_data_t *origin, coord_data_t *machine, coord_data_t *work, coord_system_data_t *offset)
+{
+    coord_data_t rotated_work;
+    uint_fast8_t idx = N_AXIS;
+
+    memcpy(&rotated_work, work, sizeof(coord_data_t));
+
+    if(gc_xy_rotation_active(offset))
+        rotate(&rotated_work, gc_xy_rotation_plane(), offset->rotation);
+
+    do {
+        idx--;
+        origin->values[idx] = machine->values[idx] - gc_state.g92_offset.coord.values[idx] - gc_state.modal.tool_length_offset[idx] - rotated_work.values[idx];
+    } while(idx);
+}
+
+static void gc_solve_g92_from_work (coord_data_t *g92, coord_data_t *machine, coord_data_t *work, coord_system_data_t *offset)
+{
+    coord_data_t rotated_work;
+    uint_fast8_t idx = N_AXIS;
+
+    memcpy(&rotated_work, work, sizeof(coord_data_t));
+
+    if(gc_xy_rotation_active(offset))
+        rotate(&rotated_work, gc_xy_rotation_plane(), offset->rotation);
+
+    do {
+        idx--;
+        g92->values[idx] = machine->values[idx] - offset->coord.values[idx] - gc_state.modal.tool_length_offset[idx] - rotated_work.values[idx];
+    } while(idx);
+}
+
+#endif
+
+void gc_get_work_position (float *position, const float *machine_position, bool real_time)
+{
+    coord_data_t wpos;
+    uint_fast8_t idx = N_AXIS;
+
+    do {
+        idx--;
+        wpos.values[idx] = machine_position[idx] - gc_get_offset(idx, real_time);
+    } while(idx);
+
+#ifdef ROTATION_ENABLE
+    if(gc_xy_rotation_active(&gc_state.modal.g5x_offset.data))
+        rotate(&wpos, gc_xy_rotation_plane(), -gc_state.modal.g5x_offset.data.rotation);
+#endif
+
+    memcpy(position, wpos.values, sizeof(coord_data_t));
+}
